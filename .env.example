# CyberSentry Environment Configuration Template
# NOTE: The hostnames below (e.g. postgres, kafka, opensearch) are container DNS names for inter-container networking.
# Host-run scripts (e.g. seed_db.py, verify_m1.py) default to localhost and must NOT blindly source this file.

# ---- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cybersentry
DB_USER=sentry
DB_PASS=sentry_dev_2026

# ---- Kafka ---
KAFKA_BOOTSTRAP=kafka:29092
TOPIC_RAW=sec.raw
TOPIC_NORMALIZED=sec.normalized
TOPIC_DETECTIONS=sec.detections
TOPIC_DLQ=sec.dlq

# ---- OpenSearch ---
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_PREFIX=sentry-events
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Sentry_Dev_2026!
EVENT_RETENTION_DAYS=30

# ---- Redis / MLflow ---
REDIS_URL=redis://redis:6379/0
MLFLOW_TRACKING_URI=http://mlflow:5000

# ---- Detection & Correlation Parameters ---
CORRELATION_WINDOW_MINUTES=60
DEDUP_WINDOW_MINUTES=15
AUTO_CONTAIN_MAX_SEVERITY=medium
INCIDENT_CRITICAL_SCORE=80